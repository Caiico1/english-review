{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lección de English Review",
  "type": "object",
  "required": ["id", "number", "title", "objectives", "vocabulary", "grammar", "exercises"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[0-9]{2}[a-z]?$", "description": "Debe coincidir con el nombre del archivo: lesson-<id>.json" },
    "number": { "type": "integer", "minimum": 1, "description": "Número de unidad del libro" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "classDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Fecha de la clase, AAAA-MM-DD" },
    "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "vocabulary": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/vocabItem" } },
    "phrases": { "type": "array", "items": { "$ref": "#/definitions/phrase" } },
    "grammar": { "type": "array", "items": { "$ref": "#/definitions/grammarPoint" } },
    "exercises": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/exercise" } },
    "reading": { "$ref": "#/definitions/reading" }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "vocabItem": {
      "type": "object",
      "required": ["id", "word", "translation", "partOfSpeech", "example", "exampleTranslation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "word": { "type": "string", "minLength": 1 },
        "translation": { "type": "string", "minLength": 1 },
        "partOfSpeech": { "type": "string", "minLength": 1 },
        "example": { "type": "string", "minLength": 1 },
        "exampleTranslation": { "type": "string", "minLength": 1 },
        "pronunciationHint": { "type": "string" }
      }
    },
    "phrase": {
      "type": "object",
      "required": ["id", "en", "es", "context"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "context": { "type": "string" }
      }
    },
    "grammarPoint": {
      "type": "object",
      "required": ["id", "title", "explanation", "rules", "examples", "commonMistakes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "examples": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["en", "es"], "additionalProperties": false,
            "properties": { "en": { "type": "string", "minLength": 1 }, "es": { "type": "string", "minLength": 1 }, "note": { "type": "string" } }
          }
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "object", "required": ["wrong", "right", "why"], "additionalProperties": false,
            "properties": { "wrong": { "type": "string", "minLength": 1 }, "right": { "type": "string", "minLength": 1 }, "why": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "reading": {
      "type": "object",
      "required": ["type", "title", "lines"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["dialogue", "text"] },
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string" },
        "lines": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["en", "es"], "additionalProperties": false,
            "properties": { "speaker": { "type": "string" }, "en": { "type": "string", "minLength": 1 }, "es": { "type": "string", "minLength": 1 } }
          }
        },
        "questions": { "type": "array", "items": { "$ref": "#/definitions/exercise" } }
      }
    },
    "exercise": {
      "description": "El campo type decide qué forma debe tener el ejercicio.",
      "oneOf": [
        {
          "type": "object", "required": ["id", "type", "prompt", "options", "answer"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "multiple-choice" },
            "prompt": { "type": "string", "minLength": 1 },
            "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
            "answer": { "type": "integer", "minimum": 0, "description": "Índice (desde 0) de la opción correcta" },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "text", "answers"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "fill-gap" },
            "prompt": { "type": "string" },
            "text": { "type": "string", "pattern": "_{3,}", "description": "Cada hueco se marca con ___" },
            "answers": {
              "type": "array", "minItems": 1, "description": "Una lista de respuestas válidas por cada hueco, en orden",
              "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "hint": { "type": "string" },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "answer"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "order-words" },
            "prompt": { "type": "string" },
            "answer": { "type": "string", "minLength": 3, "description": "La frase correcta; las fichas salen de separarla por espacios" },
            "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Otros órdenes válidos con las mismas palabras" },
            "distractors": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Palabras sobrantes" },
            "translation": { "type": "string" }, "keepCapital": { "type": "boolean" },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "pairs"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "match" },
            "prompt": { "type": "string" },
            "pairs": {
              "type": "array", "minItems": 2,
              "items": {
                "type": "object", "required": ["left", "right"], "additionalProperties": false,
                "properties": { "left": { "type": "string", "minLength": 1 }, "right": { "type": "string", "minLength": 1 } }
              }
            },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "source", "answers"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "translate" },
            "prompt": { "type": "string" },
            "source": { "type": "string", "minLength": 1, "description": "Frase en español" },
            "answers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Traducciones válidas; la primera es la que se muestra como modelo" },
            "hint": { "type": "string" },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "text"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "dictation" },
            "prompt": { "type": "string" },
            "text": { "type": "string", "minLength": 1, "description": "Frase en inglés que se leerá en voz alta" },
            "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "translation": { "type": "string" },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
