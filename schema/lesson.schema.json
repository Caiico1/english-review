{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "English Review lesson",
  "description": "All learner-facing text is in English.",
  "type": "object",
  "required": ["id", "number", "title", "objectives", "vocabulary", "grammar", "exercises"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[0-9]{2}[a-z]?$", "description": "Must match the file name: lesson-<id>.json" },
    "number": { "type": "integer", "minimum": 1, "description": "Unit number in the book" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "classDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Date of the class, YYYY-MM-DD" },
    "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "vocabulary": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/vocabItem" } },
    "phrases": { "type": "array", "items": { "$ref": "#/definitions/phrase" } },
    "grammar": { "type": "array", "items": { "$ref": "#/definitions/grammarPoint" } },
    "exercises": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/exercise" } },
    "reading": { "$ref": "#/definitions/reading" }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "vocabItem": {
      "type": "object",
      "required": ["id", "word", "definition", "partOfSpeech", "example"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "word": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1, "description": "Short definition in English" },
        "partOfSpeech": { "type": "string", "minLength": 1 },
        "example": { "type": "string", "minLength": 1 },
        "pronunciationHint": { "type": "string" }
      }
    },
    "phrase": {
      "type": "object",
      "required": ["id", "phrase", "meaning"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "phrase": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1, "description": "What the phrase means or does, in English" },
        "context": { "type": "string", "description": "When to use it, or a usage note" }
      }
    },
    "grammarPoint": {
      "type": "object",
      "required": ["id", "title", "explanation", "rules", "examples", "commonMistakes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "examples": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["en"], "additionalProperties": false,
            "properties": { "en": { "type": "string", "minLength": 1 }, "note": { "type": "string" } }
          }
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "object", "required": ["wrong", "right", "why"], "additionalProperties": false,
            "properties": { "wrong": { "type": "string", "minLength": 1 }, "right": { "type": "string", "minLength": 1 }, "why": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "reading": {
      "type": "object",
      "required": ["type", "title", "lines"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["dialogue", "text"] },
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string" },
        "lines": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["en"], "additionalProperties": false,
            "properties": { "speaker": { "type": "string" }, "en": { "type": "string", "minLength": 1 } }
          }
        },
        "questions": { "type": "array", "items": { "$ref": "#/definitions/exercise" } }
      }
    },
    "exercise": {
      "description": "The type field decides which shape the exercise must have.",
      "oneOf": [
        {
          "type": "object", "required": ["id", "type", "prompt", "options", "answer"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "multiple-choice" },
            "prompt": { "type": "string", "minLength": 1 },
            "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
            "answer": { "type": "integer", "minimum": 0, "description": "Index (from 0) of the correct option" },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "text", "answers"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "fill-gap" },
            "prompt": { "type": "string" },
            "text": { "type": "string", "pattern": "_{3,}", "description": "Mark each gap with ___" },
            "answers": {
              "type": "array", "minItems": 1, "description": "One list of accepted answers per gap, in order",
              "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "hint": { "type": "string" },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "answer"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "order-words" },
            "prompt": { "type": "string" },
            "answer": { "type": "string", "minLength": 3, "description": "The correct sentence; the tiles come from splitting it on spaces" },
            "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Other valid orders using the same words" },
            "distractors": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Extra words that are not needed" },
            "hint": { "type": "string" }, "keepCapital": { "type": "boolean" },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "pairs"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "match" },
            "prompt": { "type": "string" },
            "pairs": {
              "type": "array", "minItems": 2,
              "items": {
                "type": "object", "required": ["left", "right"], "additionalProperties": false,
                "properties": { "left": { "type": "string", "minLength": 1 }, "right": { "type": "string", "minLength": 1 } }
              }
            },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "prompt", "source", "answers"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "rewrite" },
            "prompt": { "type": "string", "minLength": 1, "description": "The instruction, e.g. Rewrite as an indirect question. Begin: Could you tell me…" },
            "source": { "type": "string", "minLength": 1, "description": "The sentence to transform" },
            "answers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Accepted answers; the first is shown as the model answer" },
            "hint": { "type": "string" },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object", "required": ["id", "type", "text"], "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/id" }, "type": { "const": "dictation" },
            "prompt": { "type": "string" },
            "text": { "type": "string", "minLength": 1, "description": "The sentence that will be read aloud" },
            "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "explanation": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
